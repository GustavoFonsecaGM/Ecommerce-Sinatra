<form action="<%= acao %>" method="post">
  <label for="nome">Nome</label>
  <input id="nome" name="nome" value="<%= h(@produto.nome) %>" required>

  <label for="descricao">Descrição</label>
  <textarea id="descricao" name="descricao" rows="3"><%= h(@produto.descricao) %></textarea>

  <label for="preco">Preço (R$)</label>
  <input id="preco" name="preco" type="number" step="0.01" min="0.01"
         value="<%= @produto.preco %>" required>

  <label for="estoque">Estoque</label>
  <input id="estoque" name="estoque" type="number" step="1" min="0"
         value="<%= @produto.estoque %>" required>

  <p><button type="submit"><%= rotulo_botao %></button></p>
</form>
<h1>Produtos</h1>

<form action="/produtos" method="get">
  <label for="q">Buscar</label>
  <input id="q" name="q" value="<%= h(@busca) %>" placeholder="nome ou descrição">
  <p><button type="submit">Buscar</button></p>
</form>

<% if @produtos.empty? %>
  <p>Nenhum produto encontrado<%= " para \"#{h(@busca)}\"" unless @busca.empty? %>.</p>
<% else %>
  <table>
    <tr><th>Produto</th><th>Preço</th><th>Estoque</th><th>Vendedor</th><th></th></tr>
    <% @produtos.each do |produto| %>
      <tr>
        <td><%= h(produto.nome) %></td>
        <td><%= moeda(produto.preco) %></td>
        <td><%= produto.estoque %></td>
        <td><%= h(produto.vendedor.nome) %></td>
        <td><a href="/produtos/<%= produto.id %>">Ver detalhes</a></td>
      </tr>
    <% end %>
  </table>
<% end %>